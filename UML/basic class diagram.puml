@startuml
title Conservatoire Virtuel - Class Diagram

skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty members

' ===== People =====

abstract class Person {
  - id: int
  - firstName: String
  - lastName: String
  - email: String
  - phone: String
  + getFullName(): String
}

class Student {
  - address: String
  - birthDate: LocalDate
  - level: String
  + enroll(): void
  + getRemainingHours(): double
}

class Teacher {
  - specializations: List<Instrument>
  - hourlyRate: double
  - qualifications: List<String>
  + checkAvailability(): boolean
}

Person <|-- Student
Person <|-- Teacher

' ===== Services and Packages =====

interface Billable {
  + calculatePrice(): double
}

abstract class Service {
  - id: int
  - name: String
  - price: double
}

class CoursePackage {
  - totalHours: int
  - startDate: LocalDate
  - endDate: LocalDate
  - type: String
  + isExpired(): boolean
  + calculatePrice(): double
}

class Lesson {
  - duration: double
  - type: String
  + addStudent(student: Student): void
  + calculateConsumedHours(): double
  + calculatePrice(): double
}

class Rental {
  - rentalType: String
  + calculatePrice(): double
}

Service ..|> Billable
Lesson ..|> Billable
Rental ..|> Billable

' ===== Enrollment =====

class Enrollment {
  - purchaseDate: LocalDate
  - remainingHours: double
  + consumeHours(hours: double): void
  + isValid(): boolean
  + getRemainingHours(): double
}

Student "1" -- "0..*" Enrollment : owns
Enrollment "*" --> "1" CoursePackage : based on
Enrollment "0..*" -- "0..*" Lesson : hours consumed

' ===== Instruments and Rooms =====

class Instrument {
  - id: int
  - name: String
  - type: String
  + isAvailable(): boolean
}

class Room {
  - id: int
  - name: String
  - capacity: int
  + isAvailable(): boolean
}

Teacher "0..*" -- "0..*" Instrument : specializes in
Student "0..*" -- "0..*" Instrument : prefers

' ===== Scheduling =====

abstract class ScheduledActivity {
  - id: int
  - dateTime: LocalDateTime
  - duration: double
  - status: String
  + cancel(): void
  + complete(): void
}

class RoomBooking {
  + bookRoom(): void
}

ScheduledActivity <|-- Lesson
ScheduledActivity <|-- RoomBooking
ScheduledActivity <|-- Exam

Teacher "1" -- "0..*" Lesson : teaches
Lesson "0..*" -- "1..*" Student : participants
Lesson "*" --> "1" Room : takes place in
Lesson "*" --> "1" Instrument : uses
RoomBooking "*" --> "1" Room : reserves

' ===== Exams =====

class Exam {
  - name: String
  - capacity: int
  + isFull(): boolean
  + registerStudent(student: Student): boolean
}

class ExamResult {
  - passed: boolean
  - score: Double
  + recordResult(): void
}

Student "0..*" -- "0..*" Exam : registers for
Instrument "1" -- "0..*" Exam : concerns

Exam "1" *-- "0..*" ExamResult : results
ExamResult "*" --> "1" Student : belongs to

' ===== Billing =====

class Invoice {
  - id: int
  - date: LocalDate
  - totalAmount: double
  + calculateTotal(): double
  + getOutstandingBalance(): double
}

class Payment {
  - id: int
  - amount: double
  - paymentDate: LocalDate
  + recordPayment(): void
}

Student "1" -- "0..*" Invoice : receives
Invoice "1" *-- "0..*" Payment : payments
Invoice "0..*" --> "1..*" Billable : charges for

' ===== Rental =====

Instrument "1" -- "0..*" Rental : rented through

@enduml
